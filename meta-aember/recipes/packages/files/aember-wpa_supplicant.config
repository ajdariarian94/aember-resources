# wpa_supplicant for aember's "wifi" package: a Wi-Fi client, nothing else.
# WPA2-PSK and WPA3-SAE (+ PMF) through wolfSSL (OpenSSL alone is ~7 MB),
# nl80211, the control socket (wpa_cli) and D-Bus (ConnMan uses it).
# Left out: P2P, WPS, AP mode, mesh, enterprise EAP (802.1X).
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_CTRL_IFACE_DBUS_NEW=y
CONFIG_TLS=wolfssl
CONFIG_SAE=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_BACKEND=file
CONFIG_L2_PACKET=linux
CONFIG_GETRANDOM=y
CONFIG_NO_RANDOM_POOL=y
