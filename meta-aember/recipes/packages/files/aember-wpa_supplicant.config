# wpa_supplicant for aember's "wifi" package: a Wi-Fi client, nothing else.
# WPA2-PSK, WPA3-SAE (+ PMF) and WPA2-Enterprise (PEAP, TTLS, TLS) through
# wolfSSL (OpenSSL alone is ~7 MB), nl80211, the control socket (wpa_cli)
# and D-Bus (ConnMan uses it; its EapMethods property fails without any EAP
# method, and with it ConnMan's whole property query).
# Left out: P2P, WPS, AP mode, mesh.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_CTRL_IFACE_DBUS_NEW=y
CONFIG_TLS=wolfssl
CONFIG_SAE=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_BACKEND=file
CONFIG_L2_PACKET=linux
CONFIG_GETRANDOM=y
CONFIG_NO_RANDOM_POOL=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_TLS=y
CONFIG_EAP_MSCHAPV2=y
