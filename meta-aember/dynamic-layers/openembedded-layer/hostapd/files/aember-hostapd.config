# hostapd for aember's "wifi-ap" package: a WPA2/WPA3 access point.
# wolfSSL (shared with the "wifi" package) instead of OpenSSL, nl80211 and
# the control socket (hostapd_cli). Left out: the EAP/RADIUS server, WPS,
# old drivers.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_TLS=wolfssl
CONFIG_SAE=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_GETRANDOM=y
CONFIG_NO_RANDOM_POOL=y
